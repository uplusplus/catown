# LLM Configuration
LLM_API_KEY=YOUR_LLM_API_KEY_HERE
LLM_BASE_URL=https://your-openai-compatible-endpoint.example/v1
LLM_MODEL=your-model-id

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Runtime database defaults to CATOWN_HOME/state/catown.db.
# Uncomment only if you need to override it.
# DATABASE_URL=/absolute/path/to/catown.db

# Monitor network events are persisted in the runtime database above.
# Keep one week of monitor/network history by default.
MONITOR_NETWORK_RETENTION_HOURS=168
# Optional safety cap for persisted monitor/network rows.
MONITOR_NETWORK_MAX_PERSISTED=50000

# Logging
LOG_LEVEL=INFO
