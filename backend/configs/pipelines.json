{
  "default": {
    "name": "标准软件开发流水线",
    "description": "需求分析 → 架构设计 → 开发 → 测试 → 发布",
    "stages": [
      {
        "name": "analysis",
        "display_name": "需求分析",
        "agent": "analyst",
        "gate": "manual",
        "timeout_minutes": 30,
        "expected_artifacts": ["docs/prd/"],
        "context_prompt": "请根据用户的原始需求，输出一份结构化的 PRD。包含用户故事、验收标准、优先级。",
        "active_skills": ["document-analysis", "requirement-decomposition", "user-story-writing"],
        "hint_only_skills": []
      },
      {
        "name": "architecture",
        "display_name": "架构设计",
        "agent": "architect",
        "gate": "auto",
        "timeout_minutes": 30,
        "expected_artifacts": ["docs/specs/"],
        "context_prompt": "请基于 PRD 进行技术选型和架构设计。包含模块划分、API 接口定义、数据库 schema。",
        "active_skills": ["architecture-design", "technology-evaluation", "api-design"],
        "hint_only_skills": ["knowledge-graph"]
      },
      {
        "name": "development",
        "display_name": "软件开发",
        "agent": "developer",
        "gate": "auto",
        "timeout_minutes": 60,
        "expected_artifacts": ["src/"],
        "context_prompt": "请按照 tech-spec 实现代码。写完一个模块后跑测试确认能用。遇到接口不清晰时可以给 architect 发消息。",
        "active_skills": ["code-generation", "unit-testing", "refactoring"],
        "hint_only_skills": ["knowledge-graph", "debugging"]
      },
      {
        "name": "ui_design",
        "display_name": "UI/UX 设计验证",
        "agent": "ui-designer",
        "gate": "auto",
        "timeout_minutes": 30,
        "expected_artifacts": ["docs/design/"],
        "context_prompt": "请对前端界面进行视觉验证和优化。使用 screenshot 截图验证，screenshot_compare 做视觉回归测试，确保响应式布局和可访问性。",
        "active_skills": ["ui-ux-pro-max"],
        "hint_only_skills": ["code-generation", "debugging"]
      },
      {
        "name": "testing",
        "display_name": "测试",
        "agent": "tester",
        "gate": "auto",
        "timeout_minutes": 30,
        "expected_artifacts": ["reports/tests/"],
        "context_prompt": "请基于 PRD 的验收标准测试代码。包含边界测试和异常路径。如果有 blocker 级别的 bug，明确标注。",
        "rollback_on_blocker": true,
        "max_rollback_count": 3,
        "rollback_target": "development",
        "active_skills": ["test-generation", "bug-reporting", "security-testing"],
        "hint_only_skills": []
      },
      {
        "name": "release",
        "display_name": "版本发布",
        "agent": "release",
        "gate": "manual",
        "timeout_minutes": 15,
        "expected_artifacts": ["CHANGELOG.md"],
        "context_prompt": "请检查测试报告，确认无 blocker 后生成 CHANGELOG 和 Git tag。",
        "active_skills": ["changelog-generation", "version-tagging", "release-management"],
        "hint_only_skills": []
      }
    ]
  }
}
